# ============================================================
# GoLo AI Assistant — Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# ─── AI / Gemini API Keys ───────────────────────────────────
GOLO_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_WARNING_KEY=your_gemini_api_key_here

# ─── Server Configuration ───────────────────────────────────
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ─── Database Configuration ─────────────────────────────────
# Supported DB types: postgresql | mysql | sqlite | mongodb
DB_TYPE=sqlite

# PostgreSQL / MySQL Connection Fields
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golo_ai_db
DB_USER=golo_user
DB_PASSWORD=your_db_password_here

# Full connection URL
# For PostgreSQL:  postgresql://golo_user:password@localhost:5432/golo_ai_db
# For MySQL:       mysql+pymysql://golo_user:password@localhost:3306/golo_ai_db
# For SQLite:      sqlite:///./golo_ai.db
DATABASE_URL=sqlite:///./golo_ai.db

# MongoDB (if using NoSQL)
MONGODB_URI=mongodb://localhost:27017/golo_ai_db
MONGODB_DB_NAME=golo_ai_db

# ─── Database Pool Settings ─────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ─── FAQ / Knowledge Base Source ────────────────────────────
# Options: "memory" (default in-memory KB) | "database" (load FAQs from DB)
FAQ_SOURCE=memory
FAQ_TABLE=golo_faqs

# ─── Redis Cache (optional) ─────────────────────────────────
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_RPM=20
RATE_LIMIT_RPD=200

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/golo_ai.log

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=*
